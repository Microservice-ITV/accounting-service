# syntax=docker/dockerfile:1

# ==================================================
# BUILD STAGE
# ==================================================
FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY prisma ./prisma
COPY src ./src

# Generate Prisma client
RUN npx prisma generate --schema=prisma/schema.prisma

# Compile TypeScript
RUN npm run build


# ==================================================
# PRODUCTION RUNTIME STAGE
# ==================================================
FROM node:22-bookworm-slim AS production

ENV NODE_ENV=production
ENV PORT=4005

WORKDIR /var/www/html/accounting-service

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app app

# Install ONLY production dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npm cache clean --force

# Copy only runtime files from build stage
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma

COPY docker/node/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.prod.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.prod.sh \
    && chown -R app:app /var/www/html/accounting-service

USER app

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.prod.sh"]

CMD ["node", "dist/server.js"]