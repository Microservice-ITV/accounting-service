{
  "name": "accounting-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');if(fs.existsSync('prisma/schema.prisma')){require('child_process').execSync('prisma generate --schema=prisma/schema.prisma',{stdio:'inherit'});}\"",
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",

    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "test:deploy": "bash scripts/test_deploy.sh",

    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx src/scripts/run-seed.ts",
    "recovery:order-paid-projection": "tsx src/scripts/recover-order-paid-projection.ts",
    "seed": "tsx src/scripts/run-seed.ts",
    "seed:accounts": "tsx src/scripts/run-seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "amqplib": "^0.10.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "prisma": "^6.19.3",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.0",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}