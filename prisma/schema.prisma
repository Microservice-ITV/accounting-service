generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum ApprovalActionType {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum PayrollLineType {
  EARNING
  DEDUCTION
}

enum PayrollLineCategory {
  BASE_SALARY
  OVERTIME
  ALLOWANCE
  COMMISSION
  BONUS
  OTHER_EARNING
  UNPAID_LEAVE
  ABSENCE
  LATENESS
  TAX
  OTHER_DEDUCTION
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  UNDER_REVIEW
  APPROVED
  PAID
  VOID
}

enum PayslipStatus {
  GENERATED
  ISSUED
  REVOKED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_PAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  RECONCILED
}

enum ExpenseScope {
  SHOP
  PLATFORM
}

enum DeliveryChargingBasis {
  PER_ORDER
  PER_INVOICE
}

model AccountingStatus {
  id        String   @id @default(cuid())
  domain    String
  code      String
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]           @relation("AccountStatus")
  categories     ExpenseCategory[]   @relation("ExpenseCategoryStatus")
  expenses       Expense[]           @relation("ExpenseStatus")
  approvals      ExpenseApproval[]   @relation("ExpenseApprovalStatus")
  settlements    PaymentSettlement[] @relation("SettlementStatus")
  journalEntries JournalEntry[]      @relation("JournalEntryStatus")

  @@unique([domain, code])
  @@index([domain, isActive])
}

model Account {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  type         AccountType
  status       String      @default("ACTIVE")
  statusDomain String      @default("ACCOUNT")
  description  String?
  parentId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  parent           Account?         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Account[]        @relation("AccountHierarchy")
  lines            EntryLine[]
  statusDefinition AccountingStatus @relation("AccountStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@index([statusDomain, status])
}

model ExpenseCategory {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String   @unique
  description  String?
  status       String   @default("ACTIVE")
  statusDomain String   @default("EXPENSE_CATEGORY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses         Expense[]
  statusDefinition AccountingStatus @relation("ExpenseCategoryStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@index([statusDomain, status])
}

model DeliveryCompanyFee {
  id                String                @id @default(cuid())
  shopId            String?
  deliveryCompanyId String?
  chargingBasis     DeliveryChargingBasis @default(PER_ORDER)
  amount            Decimal               @db.Decimal(10, 2)
  currency          String
  active            Boolean               @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([shopId, deliveryCompanyId, active, effectiveFrom, effectiveTo], map: "delivery_company_fee_shop_company_effective_idx")
  @@map("delivery_company_fees")
}

model Expense {
  id                 String       @id @default(cuid())
  expenseNo          String       @unique
  scope              ExpenseScope @default(SHOP)
  shopId             String?
  deliveryCompanyId  String?
  createdByUserId    String?
  sellerUserId       String?
  expenseTypeId      String
  expenseAccountCode String       @default("5000")
  fundingAccountCode String       @default("1000")
  amount             Decimal
  currency           String       @default("MMK")
  description        String?
  receiptImage       String?
  expenseDate        DateTime     @default(now())
  status             String       @default("DRAFT")
  statusDomain       String       @default("EXPENSE")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  submittedAt        DateTime?
  deliveryExpenseGroupId String?

  expenseType      ExpenseCategory   @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  approvals        ExpenseApproval[]
  deliveryOrders   DeliveryExpenseOrder[]
  statusDefinition AccountingStatus  @relation("ExpenseStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@unique([deliveryExpenseGroupId, shopId, deliveryCompanyId], map: "expenses_delivery_group_shop_company_key")
  @@index([shopId, status])
  @@index([deliveryCompanyId])
  @@index([scope, status])
  @@index([createdByUserId, status])
  @@index([sellerUserId, status])
  @@index([status, expenseDate])
  @@index([statusDomain, status])
}

model DeliveryExpenseOrder {
  id        String   @id @default(cuid())
  expenseId String
  orderId   String
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, orderId])
  @@index([orderId])
  @@map("delivery_expense_orders")
}

model ApprovalPolicy {
  id             String       @id @default(cuid())
  name           String
  scope          ExpenseScope @default(SHOP)
  shopId         String?
  approverUserId String?
  minAmount      Decimal      @default(0)
  maxAmount      Decimal?
  level          Int          @default(1)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conditions ApprovalPolicyCondition[]

  @@index([scope, shopId, isActive, minAmount])
}

model ApprovalPolicyCondition {
  id               String   @id @default(cuid())
  approvalPolicyId String
  field            String
  operator         String
  value            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  approvalPolicy ApprovalPolicy @relation(fields: [approvalPolicyId], references: [id], onDelete: Cascade)

  @@index([approvalPolicyId, field])
}

model ExpenseApproval {
  id             String              @id @default(cuid())
  expenseId      String
  stepNo         Int
  approverUserId String?
  status         String              @default("WAITING")
  statusDomain   String              @default("APPROVAL")
  action         ApprovalActionType?
  comment        String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  expense          Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actions          ExpenseApprovalAction[]
  statusDefinition AccountingStatus        @relation("ExpenseApprovalStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@unique([expenseId, stepNo])
  @@index([expenseId, status, stepNo])
  @@index([approverUserId, status])
  @@index([statusDomain, status])
}

model ExpenseApprovalAction {
  id                String             @id @default(cuid())
  expenseApprovalId String
  userId            String
  action            ApprovalActionType
  comment           String?
  createdAt         DateTime           @default(now())

  expenseApproval ExpenseApproval @relation(fields: [expenseApprovalId], references: [id], onDelete: Cascade)

  @@index([expenseApprovalId, createdAt])
  @@index([userId, createdAt])
}

model PaymentSettlement {
  id                  String   @id @default(cuid())
  paymentReference    String   @unique
  orderId             String?
  checkoutId          String?
  eventId             String?  @unique
  journalEntryId      String?
  currency            String   @default("MMK")
  totalAmount         Decimal
  sellerPayableAmount Decimal  @default(0)
  status              String   @default("POSTED")
  statusDomain        String   @default("SETTLEMENT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  journalEntry     JournalEntry?           @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  lines            PaymentSettlementLine[]
  statusDefinition AccountingStatus        @relation("SettlementStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@index([orderId])
  @@index([checkoutId])
  @@index([journalEntryId])
  @@index([statusDomain, status])
}

model PaymentSettlementLine {
  id            String   @id @default(cuid())
  settlementId  String
  shopId        String?
  sellerId      String?
  grossAmount   Decimal
  payableAmount Decimal  @default(0)
  currency      String   @default("MMK")
  createdAt     DateTime @default(now())

  settlement PaymentSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, shopId])
  @@index([shopId])
  @@index([sellerId])
}

model PnlOrderShop {
  id                          String                       @id @default(cuid())
  orderId                     String
  shopOrderId                 String?
  sourceEventId               String
  shopId                      String
  paymentId                   String?
  paymentStatus               String?
  currency                    String                       @default("MMK")
  grossItemSales              Decimal                      @db.Decimal(10, 2)
  discountTotal               Decimal                      @db.Decimal(10, 2)
  shippingTotal               Decimal                      @db.Decimal(10, 2)
  paidAmount                  Decimal                      @db.Decimal(10, 2)
  discountAllocationsComplete Boolean                      @default(false)
  orderPaidAt                 DateTime
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  discounts                   PnlOrderDiscountAllocation[]

  @@unique([orderId, shopId])
  @@index([shopId, orderPaidAt])
  @@index([sourceEventId])
}

model PnlOrderDiscountAllocation {
  id             String   @id @default(cuid())
  pnlOrderShopId String
  promotionId    String?
  rewardId       String?
  discountType   String
  fundedBy       String
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  pnlOrderShop PnlOrderShop @relation(fields: [pnlOrderShopId], references: [id], onDelete: Cascade)

  @@index([pnlOrderShopId, discountType, fundedBy])
}

model JournalEntry {
  id            String   @id @default(cuid())
  referenceType String
  referenceId   String
  eventId       String?  @unique
  narration     String?
  entryDate     DateTime @default(now())
  version       Int      @default(1)
  status        String   @default("POSTED")
  statusDomain  String   @default("ENTRY")
  createdAt     DateTime @default(now())

  lines            EntryLine[]
  settlements      PaymentSettlement[]
  statusDefinition AccountingStatus    @relation("JournalEntryStatus", fields: [statusDomain, status], references: [domain, code], onDelete: Restrict)

  @@unique([referenceType, referenceId])
  @@index([statusDomain, status])
}

model AccountingOutboxEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  routingKey  String
  payload     Json
  publishedAt DateTime? @db.Timestamp(3)
  createdAt   DateTime  @default(now()) @db.Timestamp(3)

  @@index([publishedAt, createdAt])
}

model EntryLine {
  id             String    @id @default(cuid())
  journalEntryId String
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id])
  direction      Direction
  amount         Decimal
  currency       String?
  shopId         String?
  memo           String?
  createdAt      DateTime  @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model PayrollPolicy {
  id                       String        @id @default(cuid())
  shopId                   String?
  name                     String
  currency                 String        @default("USD")
  standardWorkingDays      Int           @default(22)
  standardDailyHours       Decimal       @default(8.00) @db.Decimal(5, 2)
  overtimeRateMultiplier   Decimal       @default(1.50) @db.Decimal(5, 2)
  taxRate                  Decimal       @default(0.00) @db.Decimal(5, 4)
  latenessDeductionPerMin  Decimal       @default(0.00) @db.Decimal(5, 4)
  absenceDeductionPerDay   Decimal       @default(0.00) @db.Decimal(5, 2)
  unpaidLeaveDeductionPerDay Decimal     @default(0.00) @db.Decimal(5, 2)
  isActive                 Boolean       @default(true)
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  payrollRuns PayrollRun[]

  @@index([shopId, isActive])
}

model PayrollRun {
  id                 String            @id @default(cuid())
  reference          String            @unique
  periodStart        DateTime          @db.Date
  periodEnd          DateTime          @db.Date
  payDate            DateTime?         @db.Date
  status             PayrollRunStatus  @default(DRAFT)
  shopId             String?
  payrollPolicyId    String?
  currency           String            @default("USD")
  totalGross         Decimal           @default(0) @db.Decimal(12, 2)
  totalDeductions    Decimal           @default(0) @db.Decimal(12, 2)
  totalNet           Decimal           @default(0) @db.Decimal(12, 2)
  employeeCount      Int               @default(0)
  preparedBy         String?
  approvedBy         String?
  calculatedAt       DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  paidAt             DateTime?
  lockedAt           DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payrollPolicy      PayrollPolicy?    @relation(fields: [payrollPolicyId], references: [id], onDelete: SetNull)
  items              PayrollItem[]
  payslips           Payslip[]
  paymentRecords     PaymentRecord[]
  auditLogs          PayrollAuditLog[]

  @@index([shopId, status])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model PayrollItem {
  id                String        @id @default(cuid())
  payrollRunId      String
  employeeId        String
  baseSalary        Decimal       @default(0) @db.Decimal(12, 2)
  grossPay          Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions   Decimal       @default(0) @db.Decimal(12, 2)
  netPay            Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("USD")
  workedDays        Decimal       @default(0) @db.Decimal(5, 2)
  absentDays        Decimal       @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays   Decimal       @default(0) @db.Decimal(5, 2)
  overtimeMinutes   Int           @default(0)
  snapshot          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payrollRun        PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  lines             PayrollItemLine[]
  payslip           Payslip?
  paymentRecords    PaymentRecord[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollItemLine {
  id               String            @id @default(cuid())
  payrollItemId    String
  lineType         PayrollLineType
  category         PayrollLineCategory
  description      String
  quantity         Decimal?          @db.Decimal(5, 2)
  rate             Decimal?          @db.Decimal(10, 4)
  amount           Decimal           @db.Decimal(12, 2)
  sourceType       String?
  sourceId         String?
  meta             Json?
  createdAt        DateTime          @default(now())

  payrollItem      PayrollItem       @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollItemId, category])
}

model Payslip {
  id                String          @id @default(cuid())
  payslipNumber     String          @unique
  payrollRunId      String
  payrollItemId     String          @unique
  employeeId        String
  status            PayslipStatus   @default(GENERATED)
  generatedAt       DateTime        @default(now())
  issuedAt          DateTime?
  revokedAt         DateTime?
  fileUrl           String?
  snapshot          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  payrollRun        PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollItem       PayrollItem     @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, status])
  @@index([employeeId, status])
}

model PaymentRecord {
  id              String           @id @default(cuid())
  payrollRunId    String
  payrollItemId   String?
  employeeId      String
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  reference       String?
  bankName        String?
  accountLast4    String?
  paidAt          DateTime?
  processedBy     String?
  notes           String?
  meta            Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollItem     PayrollItem?     @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  @@index([payrollRunId, status])
  @@index([employeeId, status])
}

model PayrollAuditLog {
  id             String              @id @default(cuid())
  payrollRunId   String
  action         String
  actorId        String?
  actorName      String?
  description    String?
  meta           Json?
  createdAt      DateTime            @default(now())

  payrollRun     PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  @@index([payrollRunId, createdAt])
}

model OrderReturnStage {
  id         String   @id
  eventId    String   @unique
  orderId    String   @unique
  shopIds    String[] @default([])
  reason     String
  returnedAt DateTime @db.Timestamp(3)
  status     String   @default("RETURNED")
  createdAt  DateTime @default(now()) @db.Timestamp(3)
  updatedAt  DateTime @updatedAt @db.Timestamp(3)

  @@index([returnedAt])
}
