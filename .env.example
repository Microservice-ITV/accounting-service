PORT=4005
APP_NAME="Accounting Service"
# Optional override; Docker Compose defaults to the Shipping Service on the shared network.
SHIPPING_SERVICE_BASE_URL=
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/accounting_service?schema=public"
RABBITMQ_URL="amqp://guest:guest@localhost:5673"
RABBITMQ_EXCHANGE="order_events"
RABBITMQ_PAYMENT_COMPLETED_KEY="payment.completed"
RABBITMQ_PAYMENT_COLLECTED_KEY="payment.collected"
RABBITMQ_ORDER_PAID_KEY="order.paid"
RABBITMQ_PAYMENT_QUEUE="accounting.payment_completed"
RABBITMQ_INVOICE_GENERATED_KEY="invoice.generated"
RABBITMQ_INVOICE_PAID_KEY="invoice.paid"
RABBITMQ_INVOICE_PROJECTION_QUEUE="accounting.invoice_projection"
RABBITMQ_INVOICE_PROJECTION_DLQ="accounting.invoice_projection.dlq"
RABBITMQ_INVOICE_PROJECTION_RETRY_QUEUE="accounting.invoice_projection.retry_queue"
RABBITMQ_INVOICE_PROJECTION_RETRY_DELAY_MS=5000
RABBITMQ_INVOICE_PROJECTION_MAX_RETRIES=5
RABBITMQ_SHIPMENT_DELIVERED_KEY="shipment.delivered"
RABBITMQ_SHIPMENT_DELIVERED_QUEUE="accounting.shipment_delivered"
RABBITMQ_SHIPMENT_DELIVERED_DLQ="accounting.shipment_delivered.dlq"
RABBITMQ_ORDER_RETURNED_KEY="order.returned"
RABBITMQ_ORDER_RETURNED_QUEUE="accounting.order_returned"
RABBITMQ_ORDER_RETURNED_DLQ="accounting.order_returned.dlq"
RABBITMQ_INVENTORY_VALUATION_KEY="inventory.valuation.movement"
RABBITMQ_INVENTORY_VALUATION_QUEUE="accounting.inventory_valuation"
RABBITMQ_INVENTORY_VALUATION_DLQ="accounting.inventory_valuation.dlq"
RABBITMQ_INVENTORY_UPDATED_KEY="inventory.updated"
RABBITMQ_INVENTORY_LOW_STOCK_KEY="inventory.low_stock"
RABBITMQ_PURCHASE_GOODS_RECEIVED_KEY="purchase.goods_received"
RABBITMQ_PURCHASE_GOODS_RETURNED_KEY="purchase.goods_returned"
INVENTORY_VALUATION_COVERAGE_FROM=
RABBITMQ_PAYMENT_DLQ="accounting.payment_completed.dlq"
ACCOUNTING_EVENTS_EXCHANGE="accounting.events"
ACCOUNTING_JOURNAL_ENTRY_ROUTING_KEY="accounting.journal-entry.upserted"
NODE_ENV=development